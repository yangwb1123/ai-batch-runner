{
  "name": "abr-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup:iris": "bun scripts/iris.ts",
    "dev": "bun run setup:iris && vite --host 127.0.0.1",
    "check": "bun run setup:iris && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test tests",
    "build": "bun scripts/build.ts",
    "build:check": "bun scripts/build.ts --check",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.6",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/bun": "1.3.1",
    "svelte-check": "4.5.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
