{
  "requirement": {
    "original_prompt": "管理员删除文件后通知所有者，并记录审计",
    "interpreted_goal": "管理员可以治理不应保留的文件，操作可追踪，文件所有者知道处理结果",
    "user_roles": [
      "admin",
      "file-owner",
      "auditor"
    ],
    "success_outcome": "管理员可删除文件；所有者收到通知；审计可查询完整证据；无权/跨租户被拒绝"
  },
  "scope": {
    "type": "composition",
    "priority": {
      "p0": [
        "server-side permission check",
        "tenant isolation",
        "audit persistence",
        "result feedback"
      ],
      "p1": [
        "recycle-bin",
        "outbox on audit failure"
      ],
      "p2": [],
      "p3": []
    }
  },
  "scenario": {
    "entry": "snaplink-console /admin 文件管理",
    "preconditions": [
      "admin 已登录",
      "admin 有 vault.file.delete 权限"
    ],
    "happy_path": [
      "console 发起删除",
      "snaplink 授权检查",
      "aero-vault 逻辑删除",
      "audit 持久化",
      "aero-im 通知所有者"
    ],
    "failure_paths": [
      "授权失败 -> 停止",
      "文件不存在 -> 明确错误",
      "审计不可用 -> outbox"
    ],
    "follow_up": [
      "所有者在门户看到删除原因",
      "审计人员查询时间线"
    ]
  },
  "capabilities": {
    "existing": [
      "authorization-check",
      "file-lifecycle-delete",
      "event-ingest",
      "in-app-message"
    ],
    "extend": [
      "admin-ux"
    ],
    "create": [],
    "excluded": [
      "物理删除自动化"
    ]
  },
  "ownership": {
    "primary_project": "aero-vault",
    "collaborating_projects": [
      "snaplink",
      "snaplink-audit-governance",
      "aero-im",
      "snaplink-console"
    ],
    "unaffected_projects": [
      "aero-id"
    ],
