#!/usr/bin/env python3
"""pre-push hook: run the full engineering harness (snaplink parity)."""
import subprocess
import sys


def main() -> int:
    r = subprocess.run([sys.executable, "cli.py", "harness"], capture_output=True, text=True)
    if r.returncode != 0:
        print("pre-push FAILED — engineering gates not green:\n" + r.stdout + r.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
